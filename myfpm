#!/bin/bash

# Fungsi untuk mendeteksi versi OS RHEL/CentOS/AlmaLinux (7, 8, atau 9)
get_os_version() {
    if [ -f /etc/os-release ]; then
        . /etc/os-release
        echo "$VERSION_ID" | cut -d. -f1
    else
        echo "7"
    fi
}

OS_VER=$(get_os_version)

# Fungsi untuk memastikan perintah dijalankan sebagai root (hanya untuk perintah sistem)
check_root() {
    if [ "$EUID" -ne 0 ]; then
        echo "Error: Perintah ini harus dijalankan sebagai root!"
        exit 1
    fi
}

# Helper untuk menormalisasi format versi (contoh: 81, 8.1, php81, php8.1, 81.ini -> 81)
clean_version() {
    local input="$1"
    echo "$input" | sed -E 's/^php//i; s/\.ini$//i; s/\.//g'
}

# Fungsi Bantuan / Help (-h / --help)
show_help() {
    echo "======================================================================"
    echo "                 MYFPM - PHP & FPM Manager for CWP                    "
    echo "======================================================================"
    echo "Penggunaan yang tersedia:"
    echo ""
    echo "  1. Install PHP & Ekstensi Lengkap (Termasuk Redis) [Butuh Root]:"
    echo "     myfpm -i {version}"
    echo "     Contoh: myfpm -i 81  (atau myfpm -i 8.1)"
    echo "     (Otomatis install repo EPEL/Remi, modul lengkap + redis extension,"
    echo "      redis server, fpm, start service, aktifkan proxy_fcgi apache,"
    echo "      dan buat shortcut global php{version})"
    echo ""
    echo "  2. Buat Pool FPM untuk User Sistem [Butuh Root]:"
    echo "     myfpm -u {user} -v {version}"
    echo "     Contoh: myfpm -u akademik -v 81"
    echo "     (Membuat config socket khusus user dan panduan .htaccess)"
    echo ""
    echo "  3. Switch Versi PHP Aktif di Sesi Terminal (Aliasing) [Bisa Non-Root]:"
    echo "     source myfpm use {version}   (atau . myfpm use {version})"
    echo "     Contoh: source myfpm use 81"
    echo "     Contoh kembali ke default: source myfpm use default"
    echo ""
    echo "  4. Cek Lokasi & Edit File Konfigurasi (php.ini) [Bisa Non-Root]:"
    echo "     myfpm {version}.ini  atau  myfpm ini {version}"
    echo "     Contoh: myfpm 81.ini"
    echo "     Contoh: myfpm ini 8.1"
    echo "     Contoh langsung edit: myfpm 81.ini -e (atau myfpm ini 81 edit)"
    echo ""
    echo "  5. Restart Service (PHP-FPM / Redis / Apache / All) [Butuh Root]:"
    echo "     myfpm restart {version|redis|apache|all}"
    echo "     Contoh: myfpm restart 81       (Restart php81-php-fpm)"
    echo "     Contoh: myfpm restart redis    (Restart service Redis)"
    echo "     Contoh: myfpm restart all      (Restart seluruh service)"
    echo ""
    echo "  6. Manajemen Standalone Redis:"
    echo "     myfpm redis [install|status|restart|start|stop]"
    echo "     Contoh: myfpm redis status"
    echo ""
    echo "  7. Bantuan Command:"
    echo "     myfpm -h  atau  myfpm --help"
    echo "----------------------------------------------------------------------"
    echo " Tips Global Shortcut (Bisa Langsung Dipakai Non-Root User):"
    echo " Anda bisa langsung menjalankan perintah PHP spesifik versi tanpa 'use'"
    echo " Contoh: php81 artisan config:clear"
    echo "         php82 artisan cache:clear"
    echo "         php74 --version"
    echo "======================================================================"
}

# 1. Fungsi Install PHP (-i) dengan Validasi Gagal Install & Versi OS
install_php() {
    local raw_ver=$1
    if [ -z "$raw_ver" ]; then
        echo "Error: Versi PHP belum dimasukkan. Contoh: myfpm -i 81"
        exit 1
    fi

    local php_ver=$(clean_version "$raw_ver")

    # Validasi dukungan OS untuk versi PHP tertentu
    if [ "$OS_VER" -eq 9 ] && [ "$php_ver" -lt 80 ]; then
        echo "Error: PHP versi $php_ver sudah tidak disupport di AlmaLinux/RHEL 9!"
        exit 1
    fi

    echo "==> Menyiapkan Repository EPEL & Remi (OS Versi: $OS_VER)..."
    if ! rpm -q epel-release &>/dev/null; then
        yum install epel-release -y
    else
        echo "==> Repository EPEL sudah terinstall."
    fi

    if ! rpm -q remi-release &>/dev/null; then
        yum install "https://rpms.remirepo.net/enterprise/remi-release-${OS_VER}.rpm" -y
        if [ $? -ne 0 ]; then
            rpm -Uvh "https://rpms.remirepo.net/enterprise/remi-release-${OS_VER}.rpm" 2>/dev/null
            if ! rpm -q remi-release &>/dev/null; then
                echo "Error: Gagal menginstall Remi Repository."
                exit 1
            fi
        fi
    else
        echo "==> Repository Remi sudah terinstall."
    fi

    local pkg_name="php${php_ver}"
    echo "==> Menginstall ${pkg_name} dan ekstensi lengkap..."
    yum install -y \
        ${pkg_name} \
        ${pkg_name}-php-fpm \
        ${pkg_name}-php-cli \
        ${pkg_name}-php-mysqlnd \
        ${pkg_name}-php-gd \
        ${pkg_name}-php-mbstring \
        ${pkg_name}-php-xml \
        ${pkg_name}-php-opcache \
        ${pkg_name}-php-curl \
        ${pkg_name}-php-zip \
        ${pkg_name}-php-bcmath \
        ${pkg_name}-php-intl \
        ${pkg_name}-php-sodium

    # Validasi jika yum install gagal di tengah jalan
    if [ $? -ne 0 ]; then
        echo "===================================================="
        echo " ERROR: Proses instalasi yum terhenti atau gagal!"
        echo " Kemungkinan penyebab:"
        echo " - Versi PHP '$php_ver' tidak valid / tidak ada di Remi."
        echo " - Koneksi internet terputus atau repository bermasalah."
        echo "===================================================="
        exit 1
    fi

    echo "==> Menginstall ekstensi PECL Redis untuk ${pkg_name}..."
    yum install -y ${pkg_name}-php-pecl-redis5 2>/dev/null || \
    yum install -y ${pkg_name}-php-pecl-redis6 2>/dev/null || \
    yum install -y ${pkg_name}-php-pecl-redis 2>/dev/null

    echo "==> Menyiapkan dan mengaktifkan service Redis Server..."
    yum install -y redis
    systemctl enable redis 2>/dev/null
    systemctl start redis 2>/dev/null

    echo "==> Mengaktifkan dan menjalankan service ${pkg_name}-php-fpm..."
    systemctl enable ${pkg_name}-php-fpm
    systemctl start ${pkg_name}-php-fpm
    if [ $? -ne 0 ]; then
        echo "Error: Gagal menjalankan service ${pkg_name}-php-fpm."
        exit 1
    fi

    # Cek dan aktifkan mod_proxy_fcgi di Apache CWP
    local httpd_conf="/usr/local/apache/conf/httpd.conf"
    if [ -f "$httpd_conf" ]; then
        if grep -q "#LoadModule proxy_fcgi_module" "$httpd_conf"; then
            sed -i 's/#LoadModule proxy_fcgi_module/LoadModule proxy_fcgi_module/' "$httpd_conf"
            echo "==> Modul proxy_fcgi diaktifkan pada Apache."
            systemctl restart httpd
        elif ! grep -q "LoadModule proxy_fcgi_module" "$httpd_conf"; then
            echo "LoadModule proxy_fcgi_module modules/mod_proxy_fcgi.so" >> "$httpd_conf"
            echo "==> Modul proxy_fcgi ditambahkan ke Apache."
            systemctl restart httpd
        fi
    fi

    # Backup www.conf bawaan
    local www_conf="/etc/opt/remi/${pkg_name}/php-fpm.d/www.conf"
    if [ -f "$www_conf" ] && [ ! -f "${www_conf}.backup" ]; then
        cp "$www_conf" "${www_conf}.backup"
        echo "==> Backup www.conf berhasil dibuat."
    fi

    # Buat Symlink Global /usr/bin/php{version} agar bisa dipanggil langsung oleh semua user (misal: php81 artisan)
    local bin_path="/usr/bin/php${php_ver}"
    local remi_bin="/opt/remi/${pkg_name}/root/usr/bin/php"
    if [ -f "$remi_bin" ]; then
        ln -sf "$remi_bin" "$bin_path"
        chmod +x "$bin_path" 2>/dev/null
        echo "==> Shortcut global '${pkg_name}' berhasil dibuat ($bin_path)."
    fi

    echo "==> Instalasi PHP $php_ver & Redis Selesai!"
}

# 2. Fungsi Setup User Pool (-u dan -v) dengan Validasi User & FPM
setup_user_pool() {
    local user=$1
    local raw_ver=$2
    local php_ver=$(clean_version "$raw_ver")

    if [ -z "$user" ] || [ -z "$php_ver" ]; then
        echo "Error: Parameter kurang lengkap. Gunakan: myfpm -u {user} -v {version}"
        exit 1
    fi

    # Validasi apakah system user benar-benar ada di server
    if ! id "$user" &>/dev/null; then
        echo "Error: User sistem '$user' tidak ditemukan di server ini!"
        echo "Silakan buat user tersebut terlebih dahulu atau pastikan penulisan namanya benar."
        exit 1
    fi

    local pkg_name="php${php_ver}"
    local pool_dir="/etc/opt/remi/${pkg_name}/php-fpm.d"
    local pool_file="${pool_dir}/${user}.conf"
    local default_pool="${pool_dir}/www.conf"
    local socket_path="/run/${pkg_name}-${user}.sock"

    # Validasi apakah PHP FPM versi tersebut sudah diinstall
    if [ ! -d "$pool_dir" ]; then
        echo "Error: PHP FPM versi $php_ver belum terinstall!"
        echo "Install terlebih dahulu dengan perintah: myfpm -i $php_ver"
        exit 1
    fi

    if [ ! -f "$default_pool" ]; then
        echo "Error: File template www.conf tidak ditemukan di $default_pool"
        exit 1
    fi

    echo "==> Membuat konfigurasi pool FPM untuk user '$user' (PHP $php_ver)..."
    cp "$default_pool" "$pool_file"

    # Modifikasi isi file konfigurasi pool
    sed -i "s/\[www\]/\[${user}\]/g" "$pool_file"
    sed -i "s/^user = .*/user = ${user}/g" "$pool_file"
    sed -i "s/^group = .*/group = ${user}/g" "$pool_file"
    
    sed -i "s/^;listen.owner = .*/listen.owner = nobody/g" "$pool_file"
    sed -i "s/^listen.owner = .*/listen.owner = nobody/g" "$pool_file"
    
    sed -i "s/^;listen.group = .*/listen.group = nobody/g" "$pool_file"
    sed -i "s/^listen.group = .*/listen.group = nobody/g" "$pool_file"
    
    sed -i "s/^;listen.mode = .*/listen.mode = 0660/g" "$pool_file"
    sed -i "s/^listen.mode = .*/listen.mode = 0660/g" "$pool_file"

    # Comment listen.allowed_clients
    sed -i "s/^listen.allowed_clients/#listen.allowed_clients/g" "$pool_file"
    sed -i "s/^;listen.allowed_clients/#listen.allowed_clients/g" "$pool_file"

    # Set path listen socket
    sed -i "s#^listen = .*#listen = ${socket_path}#g" "$pool_file"

    # Comment listen.acl_users
    sed -i "s/^listen.acl_users/#listen.acl_users/g" "$pool_file"
    sed -i "s/^;listen.acl_users/#listen.acl_users/g" "$pool_file"

    echo "==> Merestart service ${pkg_name}-php-fpm..."
    systemctl restart ${pkg_name}-php-fpm
    if [ $? -ne 0 ]; then
        echo "Error: Gagal merestart service ${pkg_name}-php-fpm. Periksa konfigurasi pool."
        exit 1
    fi

    echo ""
    echo "===================================================="
    echo " SUKSES! Pool FPM untuk user '$user' berhasil dibuat."
    echo " Lokasi Socket: ${socket_path}"
    echo "===================================================="
    echo " Tambahkan konfigurasi berikut ke file .htaccess web Anda:"
    echo "----------------------------------------------------"
    echo "<FilesMatch \\.php$>"
    echo "    SetHandler \"proxy:unix:${socket_path}|fcgi://localhost/\""
    echo "</FilesMatch>"
    echo "===================================================="
}

# 3. Fungsi Switch CLI Version (myfpm use {version})
use_php() {
    local raw_ver=$1

    if [[ -z "$raw_ver" || "$raw_ver" == "default" ]]; then
        unalias php 2>/dev/null
        unalias composer 2>/dev/null
        echo "  Kembali ke PHP Default CWP"
        /usr/local/bin/php -v | head -n 1
        return
    fi

    local version=$(clean_version "$raw_ver")

    if [ -f "/usr/bin/php$version" ]; then
        alias php="/usr/bin/php$version"
        alias composer="/usr/bin/php$version /usr/local/bin/composer"

        echo "  Sesi ini beralih ke PHP $version"
        /usr/bin/php$version -v | head -n 1
    else
        echo "  Error: PHP $version tidak ditemukan."
    fi
}

# 4. Fungsi Menampilkan / Mengedit Lokasi File INI (myfpm 81.ini / myfpm ini 81)
show_ini_path() {
    local raw_ver=$1
    local action=$2
    local php_ver=$(clean_version "$raw_ver")

    if [ -z "$php_ver" ]; then
        echo "Error: Versi PHP belum dimasukkan. Contoh: myfpm 81.ini atau myfpm ini 81"
        exit 1
    fi

    local pkg_name="php${php_ver}"
    local ini_file="/etc/opt/remi/${pkg_name}/php.ini"
    local fpm_conf="/etc/opt/remi/${pkg_name}/php-fpm.conf"
    local pool_dir="/etc/opt/remi/${pkg_name}/php-fpm.d"

    echo "======================================================================"
    echo "             INFORMASI LOKASI KONFIGURASI PHP $php_ver ($pkg_name)     "
    echo "======================================================================"

    if [ -f "$ini_file" ]; then
        echo " Main php.ini        : $ini_file"
    else
        echo " Main php.ini        : $ini_file (File belum ada / PHP belum diinstall)"
    fi

    if [ -f "$fpm_conf" ]; then
        echo " Main php-fpm.conf   : $fpm_conf"
    else
        echo " Main php-fpm.conf   : $fpm_conf (File belum ada)"
    fi

    if [ -d "$pool_dir" ]; then
        echo " FPM Pools Directory : $pool_dir"
    else
        echo " FPM Pools Directory : $pool_dir (Direktori belum ada)"
    fi

    echo "----------------------------------------------------------------------"
    echo " Perintah Cepat Edit via Terminal:"
    echo "   nano $ini_file"
    echo "   vi $ini_file"
    echo "======================================================================"

    # Jika user menyertakan opsi edit (-e / edit)
    if [[ "$action" == "-e" || "$action" == "edit" ]]; then
        if [ ! -f "$ini_file" ]; then
            echo "Error: File $ini_file tidak ditemukan, tidak dapat membuka editor."
            exit 1
        fi

        local editor="${EDITOR:-nano}"
        if ! command -v "$editor" &>/dev/null; then
            editor="vi"
        fi

        echo "==> Membuka $ini_file dengan editor '$editor'..."
        "$editor" "$ini_file"
    fi
}

# 5. Fungsi Restart Service (myfpm restart {81|redis|apache|all})
restart_service() {
    local target=$1

    if [ -z "$target" ]; then
        echo "Error: Tentukan service yang ingin direstart."
        echo "Contoh: myfpm restart 81, myfpm restart redis, myfpm restart apache, myfpm restart all"
        exit 1
    fi

    case "$target" in
        redis)
            echo "==> Merestart service Redis..."
            systemctl restart redis
            if [ $? -eq 0 ]; then
                echo "==> Service Redis berhasil direstart."
            else
                echo "Error: Gagal merestart service Redis."
                exit 1
            fi
            ;;
        apache|httpd)
            echo "==> Merestart service Apache (httpd)..."
            systemctl restart httpd
            if [ $? -eq 0 ]; then
                echo "==> Service Apache (httpd) berhasil direstart."
            else
                echo "Error: Gagal merestart service Apache."
                exit 1
            fi
            ;;
        all)
            echo "==> Merestart seluruh service PHP-FPM, Redis, dan Apache..."
            for service in $(systemctl list-unit-files | grep -E '^php[0-9]+-php-fpm\.service' | awk '{print $1}'); do
                echo "--> Merestart $service..."
                systemctl restart "$service"
            done
            
            if systemctl is-active --quiet redis 2>/dev/null; then
                echo "--> Merestart redis..."
                systemctl restart redis
            fi

            if systemctl is-active --quiet httpd 2>/dev/null; then
                echo "--> Merestart httpd..."
                systemctl restart httpd
            fi
            echo "==> Seluruh service berhasil direstart!"
            ;;
        *)
            local php_ver=$(clean_version "$target")
            if [[ -n "$php_ver" && "$php_ver" =~ ^[0-9]+$ ]]; then
                local service_name="php${php_ver}-php-fpm"
                echo "==> Merestart service ${service_name}..."
                systemctl restart "${service_name}"
                if [ $? -eq 0 ]; then
                    echo "==> Service ${service_name} berhasil direstart."
                else
                    echo "Error: Gagal merestart service ${service_name}. Pastikan PHP ${php_ver} sudah terinstall."
                    exit 1
                fi
            else
                echo "Error: Service atau versi PHP '$target' tidak dikenali."
                echo "Penggunaan: myfpm restart {version|redis|apache|all}"
                exit 1
            fi
            ;;
    esac
}

# 6. Fungsi Manajemen Standalone Redis (myfpm redis [install|status|restart|start|stop])
manage_redis() {
    local action=${1:-status}

    case "$action" in
        install)
            echo "==> Menginstall Redis Server..."
            if ! rpm -q epel-release &>/dev/null; then
                yum install epel-release -y
            fi
            yum install redis -y
            systemctl enable --now redis
            echo "==> Redis Server berhasil diinstall dan dijalankan."
            ;;
        status)
            systemctl status redis
            ;;
        restart)
            restart_service redis
            ;;
        start)
            echo "==> Menjalankan service Redis..."
            systemctl start redis
            ;;
        stop)
            echo "==> Menghentikan service Redis..."
            systemctl stop redis
            ;;
        *)
            echo "Penggunaan: myfpm redis [install|status|restart|start|stop]"
            ;;
    esac
}

# Parser Argumen Utama
case "$1" in
    -i|install)
        check_root
        install_php "$2"
        ;;
    -u|user)
        check_root
        shift
        USER_NAME=""
        PHP_VER=""
        while [[ "$#" -gt 0 ]]; do
            case $1 in
                -u|--user) USER_NAME="$2"; shift ;;
                -v|--version) PHP_VER="$2"; shift ;;
            esac
            shift
        done
        setup_user_pool "$USER_NAME" "$PHP_VER"
        ;;
    use)
        use_php "$2"
        ;;
    ini|config)
        show_ini_path "$2" "$3"
        ;;
    *.ini|*.INI)
        show_ini_path "$1" "$2"
        ;;
    restart)
        check_root
        restart_service "$2"
        ;;
    redis)
        if [[ "$2" == "install" || "$2" == "restart" || "$2" == "start" || "$2" == "stop" ]]; then
            check_root
        fi
        manage_redis "$2"
        ;;
    -h|--help)
        show_help
        ;;
    *)
        RAW_INPUT="$1"
        CLEANED=$(clean_version "$RAW_INPUT")
        if [[ -n "$CLEANED" && "$CLEANED" =~ ^[0-9]+$ ]]; then
            show_ini_path "$RAW_INPUT" "$2"
        else
            show_help
        fi
        ;;
esac
